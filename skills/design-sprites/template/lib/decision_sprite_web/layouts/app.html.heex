<div class="wrap">
  <header class="top">
    <p class="eyebrow">Decision session with Muse</p>
    <h1 class="app-title">{DecisionSprite.Content.app_title()}</h1>
    <p class="sub">Your answers are saved word for word and shape what gets built.</p>
  </header>
  <nav class="tabs">
    <a href="/" class={assigns[:current_tab] == :design && "on"}>The design</a>
    <a href="/questions" class={assigns[:current_tab] == :questions && "on"}>Decisions</a>
  </nav>
  <main>
    {@inner_content}
  </main>
</div>
